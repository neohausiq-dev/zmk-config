/*
 * Corne keymap translated 1:1 from the VIA backup (captured 2026-10-20).
 * Layers: Base, Lower (mo 1), Raise (mo 2), Adjust (Lower + Raise held).
 * Known quirk kept on purpose: inner thumbs on layers 1-3 are Space/Enter
 * (stock order) while Base has Enter/Space. Change those six keys to &trans
 * if you want Enter/Space to match the base layer.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P    &kp BSPC
&kp TAB   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RALT
                  &kp LGUI &mo 1 &kp RET   &kp SPACE &mo 2 &kp LCTRL
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LG(LS(GRAVE)) &kp EXCL &kp AT         &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR  &kp KP_PLUS
&kp LG(TAB)       &kp N1   &kp N2         &kp N3    &kp N4    &kp N5      &kp N6    &kp N7   &kp N8   &kp N9   &kp N0    &kp MINUS
&kp LG(LS(GRAVE)) &none    &kp LG(LS(N4)) &kp LG(C) &kp LG(V) &none       &none     &kp LEFT &kp UP   &kp DOWN &kp QMARK &kp PIPE
                          &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE &kp EXCL &kp GRAVE &kp BSLH &kp DLLR          &kp PRCNT   &kp CARET &kp LBKT      &kp STAR &kp LPAR &kp RPAR  &kp EQUAL
&kp LCTRL &none    &none     &none    &kp LC(SPACE)     &none       &kp MINUS &kp RBKT      &kp LBKT &kp UP   &kp BSLH  &kp MINUS
&kp LSHFT &none    &none     &none    &kp LG(LA(LS(V))) &none       &kp UNDER &kp LS(LG(M)) &kp LEFT &kp DOWN &kp RIGHT &kp TILDE
                          &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bootloader &none &none &none &none &none   &bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&none       &none &none &none &none &none   &none      &none         &none        &none        &none        &none
&none       &none &none &none &none &none   &none      &kp LS(LG(M)) &none        &none        &none        &none
                          &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
            >;
        };
    };
};
